{
  "manifest_version": 3,
  "name": "Perch",
  "version": "0.6.5",
  "description": "Your Claude Code agents on every new tab — status, context, attention ranking, one click back to the terminal.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "host_permissions": [
    "http://localhost:4242/*",
    "http://127.0.0.1:4242/*"
  ]
}
